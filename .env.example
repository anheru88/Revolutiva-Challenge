# Orquestación Docker Compose para PayIn Platform — ./run.sh lo copia a .env.
# Estos valores alimentan la interpolación de docker-compose (puertos, BD, key).

# Puerto publicado de la API (dentro del contenedor siempre es 8000).
BACKEND_PORT=8000

# Puerto publicado de MariaDB en el host (dentro del contenedor siempre 3306).
# Se usa 3307 para no chocar con un MySQL/MariaDB local en el 3306.
DB_PORT=3307

# Application key de Laravel. ./run.sh la rellena si se deja vacía.
APP_KEY=

# Credenciales de MariaDB. El backend conecta al host "db" en la red de compose.
DB_DATABASE=payin
DB_USERNAME=payin
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
