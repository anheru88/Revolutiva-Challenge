        <!-- PayIn aggregate root -->
        <mxCell id="payin" value="&lt;b&gt;PayIn&lt;/b&gt; &lt;i&gt;(Aggregate Root)&lt;/i&gt;&lt;hr&gt;- id&#10;- uuid: UUID&#10;- customerId / accountId&#10;- paymentMethodId&#10;- paymentProviderId&#10;- amount: Money&#10;- status: PayInStatus&#10;- providerRequest / providerResponse&#10;&#10;+ validate()&#10;+ markProcessed() / markFailed()&#10;+ transitionTo(status)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="290" height="250" as="geometry"/></mxCell>

